# ===========================================
# Omnigent — Portainer stack environment
# ===========================================
# Copy to .env for a local `docker compose up`, or set these as the
# Portainer stack's environment variables (Stacks → omnigent →
# Environment variables). Portainer does not read this file.

# -------------------------------------------
# REQUIRED — the stack will not start without these
# -------------------------------------------

# Public hostname. Becomes the Traefik Host() rule and OMNIGENT_DOMAIN.
OMNIGENT_HOST=omnigent.example.com

# Name of the EXISTING external network Traefik is attached to on your
# host. Must match exactly or the stack fails with "network not found".
# Find it with:  podman network ls   (or: docker network ls)
# Usually <traefik-stack-name>_default.
TRAEFIK_NETWORK_NAME=traefik_default

# Postgres password. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-strong-password

# -------------------------------------------
# Optional — defaults shown
# -------------------------------------------

# --- Traefik ---
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Database ---
POSTGRES_USER=omnigent
POSTGRES_DB=omnigent

# --- Auth: oidc (default) ---
# Required in oidc mode; the server fails loud at startup without them.
# Create a client in your IdP whose redirect URI is exactly
#   https://${OMNIGENT_HOST}/auth/callback
# (the server derives it from OMNIGENT_HOST — it is not configurable).
OMNIGENT_AUTH_PROVIDER=oidc
OMNIGENT_OIDC_ISSUER=https://your-idp.example.com
OMNIGENT_OIDC_CLIENT_ID=
OMNIGENT_OIDC_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
OMNIGENT_OIDC_COOKIE_SECRET=

# Optional OIDC tuning
OMNIGENT_OIDC_SCOPES=
OMNIGENT_OIDC_ALLOWED_DOMAINS=
OMNIGENT_OIDC_SESSION_TTL_HOURS=8
# Set to 1 to let an admin invite one off-domain email
OMNIGENT_OIDC_ALLOW_INVITES=

# --- Traefik middlewares ---
# Empty in oidc mode: omnigent does its own auth, and forward-auth in
# front of it 401s the cookieless CLI (`omnigent login` / `omnigent host`).
OMNIGENT_MIDDLEWARES=

# --- Auth: header mode (alternative to oidc) ---
# Only if OMNIGENT_AUTH_PROVIDER=header. Then also set
# OMNIGENT_MIDDLEWARES=auth-errors@docker,forward-auth@docker
# and make sure this header name is in the middleware's
# authResponseHeaders — any other name is client-spoofable. oauth2-proxy
# with SET_XAUTHREQUEST=true emits X-Auth-Request-Email.
# No CLI login in this mode: /auth/cli-login returns 404.
OMNIGENT_AUTH_HEADER=

# --- Config ---
# Path to a config.yaml inside the container (on the artifact-data
# volume) to pin harnesses/models/policies declaratively.
# See upstream deploy/docker/config.yaml.example.
OMNIGENT_CONFIG=

# --- Names: private network, containers, volumes ---
# This one is created by the stack, not looked up — rename only if it
# collides with something already on the host.
INTERNAL_NETWORK_NAME=omnigent_internal
OMNIGENT_CONTAINER_NAME=omnigent
DB_CONTAINER_NAME=omnigent-db
DB_VOLUME_NAME=omnigent_db-data
ARTIFACT_VOLUME_NAME=omnigent_artifact-data

# --- Images ---
# omnigent's own image is pinned by the deploy branch, not here.
POSTGRES_IMAGE=postgres:16-alpine
